# --- Service principal auth (only needed when `az login` isn't available) ---
# client_id, tenant_id, and subscription_id can go here safely.
# NEVER put client_secret in this file -- set it via an environment variable
# instead, e.g.:
#   $env:TF_VAR_client_secret = "<secret>"   (PowerShell)
#   export TF_VAR_client_secret="<secret>"   (bash)
# client_id       = "00000000-0000-0000-0000-000000000000"
# tenant_id       = "00000000-0000-0000-0000-000000000000"
# subscription_id = "00000000-0000-0000-0000-000000000000"

prefix              = "wbhkrnw"
location            = "eastus"
resource_group_name = "rg-webhook-renewal-spike"

# This stack creates the Automation Account and runbook too (greenfield).
# Change these only if you want different names -- nothing needs to
# pre-exist.
automation_account_name = "aa-webhook-renewal-spike"
runbook_name             = "Spike-Target-Runbook"
webhook_name             = "spike-renewable-webhook"

renewal_lead_days = 14
