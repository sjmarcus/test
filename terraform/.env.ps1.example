# Copy this file to .env.ps1 (same folder) and fill in real values.
# .env.ps1 is gitignored -- it will never be committed.
#
# deploy.ps1 dot-sources .env.ps1 automatically if it exists, so you won't
# be prompted for credentials on each run.

$script:SpClientId       = "00000000-0000-0000-0000-000000000000"
$script:SpClientSecret   = "put-the-real-secret-here"
$script:SpTenantId       = "00000000-0000-0000-0000-000000000000"
$script:SpSubscriptionId = "00000000-0000-0000-0000-000000000000"
